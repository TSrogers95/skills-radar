{
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/check-sources",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/sync-standards",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/sync-occupations",
      "schedule": "0 5 * * 1"
    }
  ]
}
