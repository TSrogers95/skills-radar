{
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/guides/apprenticeship-funding-audit-checklist",
      "destination": "/guides/apprenticeship-funding-audit",
      "permanent": true
    },
    {
      "source": "/guides/apprenticeship-funding-audit-checklist.html",
      "destination": "/guides/apprenticeship-funding-audit",
      "permanent": true
    },
    {
      "source": "/guides/apprenticeship-funding-compliance-checklist",
      "destination": "/guides/apprenticeship-funding-compliance",
      "permanent": true
    },
    {
      "source": "/guides/apprenticeship-funding-compliance-checklist.html",
      "destination": "/guides/apprenticeship-funding-compliance",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/check-sources",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/sync-standards",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/sync-occupations",
      "schedule": "0 5 * * 1"
    }
  ]
}
